{
  // Confere os tipos do Worker (lib de Workers, sem DOM) — o tsconfig da raiz é o do Next/navegador.
  // `npm run typecheck:worker`
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["./**/*.ts", "../party/**/*.ts"],
  "exclude": ["../**/*.test.ts", "../party/test-utils.ts"]
}
